#!/usr/bin/env python3
"""Query LLM subscription usage for Claude and Codex providers.

Reads OAuth tokens persisted by OpenCode, queries usage endpoints for both
Claude (Anthropic) and Codex (OpenAI/ChatGPT), and displays quota information.

Modes:
    rage-limit              Pretty-print all usage windows to the terminal
    rage-limit --json       Single waybar-compatible JSON line
    rage-limit --listen     Continuous JSON output for ashell listen_cmd

The OAuth access tokens are read from ~/.local/share/opencode/auth.json.
When expired they are refreshed automatically using the stored refresh tokens.
"""

from __future__ import annotations

import argparse
import json
import os
import signal
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Optional

# ── Constants ────────────────────────────────────────────────────────

AUTH_PATH = Path.home() / ".local" / "share" / "opencode" / "auth.json"

# Claude (Anthropic)
CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
CLAUDE_TOKEN_URL = "https://console.anthropic.com/v1/oauth/token"
CLAUDE_CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"

# Codex (OpenAI/ChatGPT)
CODEX_USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"

POLL_INTERVAL = 900  # 15 minutes
WARN_THRESHOLD = 60
ALERT_THRESHOLD = 85
BAR_WIDTH = 16


# ── Data Classes ─────────────────────────────────────────────────────


@dataclass
class UsageWindow:
    """Normalized usage window data."""

    label: str
    utilization: float
    resets_in_seconds: int


@dataclass
class ProviderUsage:
    """Usage data for a single provider."""

    name: str
    windows: list[UsageWindow]
    error: Optional[str] = None


# ── Token Management ─────────────────────────────────────────────────


def read_auth(provider_key: str) -> dict[str, Any] | None:
    """Read a provider entry from OpenCode's auth store."""
    try:
        with open(AUTH_PATH) as f:
            data = json.load(f)
        auth = data.get(provider_key)
        if not auth or auth.get("type") != "oauth":
            return None
        return auth
    except (FileNotFoundError, json.JSONDecodeError, KeyError):
        return None


def refresh_claude_token(auth: dict[str, Any]) -> str:
    """Refresh an expired Claude access token and persist the new credentials."""
    payload = json.dumps({
        "grant_type": "refresh_token",
        "refresh_token": auth["refresh"],
        "client_id": CLAUDE_CLIENT_ID,
    }).encode()

    req = urllib.request.Request(
        CLAUDE_TOKEN_URL,
        data=payload,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        token_data = json.loads(resp.read())

    new_auth = {
        "type": "oauth",
        "refresh": token_data["refresh_token"],
        "access": token_data["access_token"],
        "expires": int(time.time() * 1000) + token_data["expires_in"] * 1000,
    }

    _update_auth_file("anthropic", new_auth)
    return token_data["access_token"]


def _update_auth_file(provider_key: str, new_auth: dict[str, Any]) -> None:
    """Atomically update a provider entry in the auth file."""
    with open(AUTH_PATH) as f:
        full_data = json.load(f)
    full_data[provider_key] = new_auth

    fd, tmp_path = tempfile.mkstemp(dir=AUTH_PATH.parent, suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(full_data, f, indent=2)
            f.write("\n")
        os.replace(tmp_path, AUTH_PATH)
    except BaseException:
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


def get_claude_token() -> str | None:
    """Return a valid Claude access token, refreshing if necessary."""
    auth = read_auth("anthropic")
    if not auth:
        return None
    expires_ms = auth.get("expires", 0)
    if not auth.get("access") or expires_ms < time.time() * 1000:
        try:
            return refresh_claude_token(auth)
        except Exception:
            return None
    return auth["access"]


def get_codex_token() -> str | None:
    """Return a valid Codex access token."""
    auth = read_auth("openai")
    if not auth:
        return None
    # Codex tokens may not need refresh via this script (handled by OpenCode)
    # Just return the access token if present
    return auth.get("access")


# ── Usage Fetch ──────────────────────────────────────────────────────


def _seconds_until(resets_at: str | None, now: datetime | None = None) -> int:
    """Return seconds until an ISO timestamp, clamped to zero."""
    if not resets_at:
        return 0
    reset_dt = datetime.fromisoformat(resets_at)
    current = now or datetime.now(timezone.utc)
    delta = reset_dt - current
    return max(int(delta.total_seconds()), 0)


def parse_claude_windows(data: dict[str, Any], now: datetime | None = None) -> list[UsageWindow]:
    """Normalize Claude's usage response into display windows."""
    windows = []

    limits = data.get("limits")
    if isinstance(limits, list):
        for limit in limits:
            if not isinstance(limit, dict):
                continue

            kind = limit.get("kind")
            if kind == "session":
                label = "5-hour"
            elif kind == "weekly_all":
                label = "7-day"
            elif kind == "weekly_scoped":
                scope = limit.get("scope") or {}
                model = scope.get("model") or {}
                label = model.get("display_name") or "Scoped"
            else:
                continue

            windows.append(UsageWindow(
                label=label,
                utilization=limit.get("percent", 0),
                resets_in_seconds=_seconds_until(limit.get("resets_at"), now),
            ))

        if windows:
            return windows

    window_map = [
        ("five_hour", "5-hour"),
        ("seven_day", "7-day"),
        ("seven_day_sonnet", "Sonnet"),
        ("seven_day_opus", "Opus"),
    ]
    for key, label in window_map:
        w = data.get(key)
        if w:
            windows.append(UsageWindow(
                label=label,
                utilization=w.get("utilization", 0),
                resets_in_seconds=_seconds_until(w.get("resets_at"), now),
            ))

    return windows


def _codex_window_label(key: str, window_count: int, resets_in_seconds: int) -> str:
    """Return a stable label for Codex windows across temporary API shapes."""
    if key == "secondary_window":
        return "7-day"
    if key == "primary_window" and window_count == 1 and resets_in_seconds > 5 * 3600:
        return "7-day"
    return "5-hour"


def parse_codex_windows(data: dict[str, Any]) -> list[UsageWindow]:
    """Normalize Codex's usage response into display windows."""
    windows = []
    rate_limit = data.get("rate_limit", {})
    if not isinstance(rate_limit, dict):
        return windows

    window_keys = [
        key for key in ("primary_window", "secondary_window")
        if isinstance(rate_limit.get(key), dict)
    ]
    for key in window_keys:
        w = rate_limit[key]
        resets_in_seconds = w.get("reset_after_seconds", 0)
        windows.append(UsageWindow(
            label=_codex_window_label(key, len(window_keys), resets_in_seconds),
            utilization=w.get("used_percent", 0),
            resets_in_seconds=resets_in_seconds,
        ))

    return windows


def fetch_claude_usage() -> ProviderUsage:
    """Fetch Claude usage data."""
    token = get_claude_token()
    if not token:
        return ProviderUsage(name="Claude", windows=[], error="No auth")

    try:
        req = urllib.request.Request(
            CLAUDE_USAGE_URL,
            headers={
                "Authorization": f"Bearer {token}",
                "anthropic-beta": "oauth-2025-04-20",
            },
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read())

        return ProviderUsage(name="Claude", windows=parse_claude_windows(data))
    except Exception as e:
        return ProviderUsage(name="Claude", windows=[], error=str(e))


def fetch_codex_usage() -> ProviderUsage:
    """Fetch Codex usage data."""
    token = get_codex_token()
    if not token:
        return ProviderUsage(name="Codex", windows=[], error="No auth")

    try:
        req = urllib.request.Request(
            CODEX_USAGE_URL,
            headers={"Authorization": f"Bearer {token}"},
        )
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read())

        return ProviderUsage(name="Codex", windows=parse_codex_windows(data))
    except Exception as e:
        return ProviderUsage(name="Codex", windows=[], error=str(e))


def fetch_all_usage() -> list[ProviderUsage]:
    """Fetch usage from all providers."""
    return [fetch_claude_usage(), fetch_codex_usage()]


# ── Formatting ───────────────────────────────────────────────────────


def format_remaining(seconds: int) -> str:
    """Convert seconds to a compact remaining-time string."""
    if seconds <= 0:
        return "<1m"

    days, remainder = divmod(seconds, 86400)
    hours, remainder = divmod(remainder, 3600)
    minutes = remainder // 60

    if days > 0:
        return f"{days}d{hours}h"
    if hours > 0:
        return f"{hours}h{minutes:02d}m"
    if minutes > 0:
        return f"{minutes}m"
    return "<1m"


def state_for_pct(pct: float) -> str:
    """Return the alt-field state string for a given utilization percentage."""
    if pct >= ALERT_THRESHOLD:
        return "alert"
    if pct >= WARN_THRESHOLD:
        return "warn"
    return "ok"


def format_bar(pct: float) -> str:
    """Build a unicode progress bar of BAR_WIDTH characters."""
    filled = round(pct / 100 * BAR_WIDTH)
    filled = max(0, min(BAR_WIDTH, filled))
    return "█" * filled + "░" * (BAR_WIDTH - filled)


def colorize(text: str, pct: float) -> str:
    """Wrap text in ANSI color codes based on utilization thresholds."""
    if pct >= ALERT_THRESHOLD:
        code = "31"  # red
    elif pct >= WARN_THRESHOLD:
        code = "33"  # yellow
    else:
        code = "32"  # green
    return f"\033[{code}m{text}\033[0m"


# Priority order for window selection: 5-hour > 7-day > everything else
_WINDOW_PRIORITY = {"5-hour": 0, "7-day": 1}


def format_json(providers: list[ProviderUsage]) -> str:
    """Build a single waybar-compatible JSON line from shortest-term window data."""
    parts = []
    worst_state = "ok"

    for provider in providers:
        if provider.error or not provider.windows:
            continue

        # Select window by priority (5-hour > 7-day > others), then by reset time
        shortest = min(
            provider.windows,
            key=lambda w: (_WINDOW_PRIORITY.get(w.label, 999), w.resets_in_seconds),
        )

        pct = shortest.utilization
        prefix = "C" if provider.name == "Claude" else "X"

        if pct <= 0:
            # Show provider at 0% without remaining time
            parts.append(f"{prefix}:0%")
        else:
            remaining = format_remaining(shortest.resets_in_seconds)
            parts.append(f"{prefix}:{pct:.0f}%({remaining})")

        state = state_for_pct(pct)
        if state == "alert":
            worst_state = "alert"
        elif state == "warn" and worst_state != "alert":
            worst_state = "warn"

    if not parts:
        return json.dumps({"text": "", "alt": "ok"})

    return json.dumps({"text": " ".join(parts), "alt": worst_state})


def format_human(providers: list[ProviderUsage]) -> str:
    """Build a multi-line human-readable table of all usage windows."""
    use_color = sys.stdout.isatty()
    lines: list[str] = []

    for i, provider in enumerate(providers):
        if i > 0:
            lines.append("")  # blank line between providers

        header = provider.name
        separator = "─" * 48

        if use_color:
            lines.append(f"\033[1m{header}\033[0m")
            lines.append(f"\033[2m{separator}\033[0m")
        else:
            lines.append(header)
            lines.append(separator)

        if provider.error:
            lines.append(f"  Error: {provider.error}")
            continue

        if not provider.windows:
            lines.append("  No data")
            continue

        for window in provider.windows:
            pct = window.utilization
            remaining = format_remaining(window.resets_in_seconds)
            bar = format_bar(pct)

            if use_color:
                bar_colored = colorize(bar, pct)
                pct_colored = colorize(f"{pct:3.0f}%", pct)
                lines.append(
                    f"  {window.label:<10s} {bar_colored}  {pct_colored}   resets in {remaining}"
                )
            else:
                lines.append(
                    f"  {window.label:<10s} {bar}  {pct:3.0f}%   resets in {remaining}"
                )

    return "\n".join(lines)


# ── Main ─────────────────────────────────────────────────────────────


def run_once_json() -> None:
    """Fetch usage and print a single JSON line."""
    try:
        providers = fetch_all_usage()
        print(format_json(providers), flush=True)
    except Exception:
        print(json.dumps({"text": "?", "alt": "error"}), flush=True)
        sys.exit(1)


def run_once_human() -> None:
    """Fetch usage and print a human-readable table."""
    try:
        providers = fetch_all_usage()
        print(format_human(providers))
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        sys.exit(1)


def run_listen(interval: int) -> None:
    """Continuously fetch usage and print JSON lines for ashell.

    Responds to SIGUSR1 by immediately re-fetching instead of waiting
    for the next poll interval.
    """
    wake_event = threading.Event()

    def _handle_sigusr1(signum: int, frame: Any) -> None:
        wake_event.set()

    signal.signal(signal.SIGUSR1, _handle_sigusr1)

    while True:
        try:
            providers = fetch_all_usage()
            print(format_json(providers), flush=True)
        except Exception:
            print(json.dumps({"text": "?", "alt": "error"}), flush=True)

        wake_event.wait(timeout=interval)
        wake_event.clear()


def main() -> None:
    """Parse arguments and dispatch to the appropriate mode."""
    parser = argparse.ArgumentParser(
        description="Query LLM subscription usage (Claude & Codex).",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="output a single waybar-compatible JSON line and exit",
    )
    parser.add_argument(
        "--listen",
        action="store_true",
        help="continuously output JSON lines (for ashell listen_cmd)",
    )
    parser.add_argument(
        "--interval",
        type=int,
        default=POLL_INTERVAL,
        help=f"poll interval in seconds for --listen (default: {POLL_INTERVAL})",
    )

    args = parser.parse_args()

    if args.listen:
        run_listen(args.interval)
    elif args.json:
        run_once_json()
    else:
        run_once_human()


if __name__ == "__main__":
    main()
