#!/usr/bin/env python3
"""Enriched tmux session listing for fzf pickers and status bar indicators.

Queries tmux sessions and enriches each with:
  - Git branch for the session's working directory
  - OpenCode sessions grouped under their owning tmux session, with
    live status (idle, running, question, error, done) and titles
    from runtime state files written by the session-state plugin
  - Open GitHub PR for the current branch (via gh, cached with bkt)

Subcommands:
    tmux-sessions list          ANSI-coloured lines for an fzf picker
    tmux-sessions indicator     Compact tmux status-bar segment (highest severity)
    tmux-sessions switch LINE   Switch to the opencode window in session from LINE
    tmux-sessions preview LINE  Capture the opencode pane for fzf preview
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass, field
from datetime import datetime
from pathlib import Path
from typing import Optional


# ── Constants ────────────────────────────────────────────────────────

OPENCODE_STATE_DIR = Path(
    os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
) / "opencode" / "session-state"
BKT_TTL = "5m"

# OpenCode state priority for indicator rendering (higher = more severe)
OC_PRIORITY = {"idle": 0, "running": 1, "done": 2, "question": 3, "error": 4}

# States that need user attention always beat states that don't
OC_NEEDS_ATTENTION = {
    "question": True, "error": True, "done": True,
    "running": False, "idle": False,
}

# Within the same attention tier, prefer the more urgent/informative state
OC_WITHIN_TIER = {"question": 3, "error": 2, "done": 1, "running": 1, "idle": 0}

# Nerd font icon for opencode
OC_ICON = "󱜙"


# ── Rose Pine colours (true-colour ANSI) ─────────────────────────────

class _Colours:
    """Rose Pine ANSI true-colour codes, degrading to empty when disabled."""

    def __init__(self, enabled: bool) -> None:
        self._on = enabled

    def _fg(self, hex_colour: str) -> str:
        if not self._on:
            return ""
        r, g, b = int(hex_colour[1:3], 16), int(hex_colour[3:5], 16), int(hex_colour[5:7], 16)
        return f"\033[38;2;{r};{g};{b}m"

    def _bg(self, hex_colour: str) -> str:
        if not self._on:
            return ""
        r, g, b = int(hex_colour[1:3], 16), int(hex_colour[3:5], 16), int(hex_colour[5:7], 16)
        return f"\033[48;2;{r};{g};{b}m"

    @property
    def reset(self) -> str:
        return "\033[0m" if self._on else ""

    @property
    def bold(self) -> str:
        return "\033[1m" if self._on else ""

    @property
    def dim(self) -> str:
        return "\033[2m" if self._on else ""

    @property
    def text(self) -> str:
        return self._fg("#e0def4")

    @property
    def gold(self) -> str:
        return self._fg("#f6c177")

    @property
    def rose(self) -> str:
        return self._fg("#ebbcba")

    @property
    def love(self) -> str:
        return self._fg("#eb6f92")

    @property
    def foam(self) -> str:
        return self._fg("#9ccfd8")

    @property
    def iris(self) -> str:
        return self._fg("#c4a7e7")

    @property
    def pine(self) -> str:
        return self._fg("#31748f")

    @property
    def muted(self) -> str:
        return self._fg("#6e6a86")

    @property
    def subtle(self) -> str:
        return self._fg("#908caa")

    # Background colors
    @property
    def bg_base(self) -> str:
        return self._bg("#191724")

    @property
    def bg_overlay(self) -> str:
        return self._bg("#26233a")


# ── Data types ───────────────────────────────────────────────────────

@dataclass
class PRInfo:
    number: int
    title: str
    url: str
    is_draft: bool


@dataclass
class SessionInfo:
    name: str
    directory: str
    branch: Optional[str]
    has_opencode: bool
    opencode_state: Optional[str]  # "error" | "question" | "running" | "idle"
    last_activity: int
    pr: Optional[PRInfo]
    opencode_sessions: list[OpenCodeRuntimeState] = field(default_factory=list)


@dataclass
class OpenCodeRuntimeState:
    session_id: str
    directory: str
    worktree: str
    state: str
    updated_at: int
    title: str = ""
    time_updated: int = 0
    server_url: str = ""


def _prefer_runtime_state(candidate: OpenCodeRuntimeState, current: OpenCodeRuntimeState) -> bool:
    """Choose the state that best represents what needs attention now.

    States needing user attention (question, error) always beat states that
    don't (running, idle), regardless of timestamp.  Within the same attention
    tier, prefer the more urgent state, then the newer timestamp.
    """
    c_attn = OC_NEEDS_ATTENTION.get(candidate.state, False)
    r_attn = OC_NEEDS_ATTENTION.get(current.state, False)
    if c_attn != r_attn:
        return c_attn

    c_tier = OC_WITHIN_TIER.get(candidate.state, 0)
    r_tier = OC_WITHIN_TIER.get(current.state, 0)
    if c_tier != r_tier:
        return c_tier > r_tier

    return candidate.updated_at > current.updated_at


# ── Tmux queries ─────────────────────────────────────────────────────

@dataclass
class TmuxSession:
    name: str
    path: str
    last_activity: int
    windows: list[dict[str, str]]


def tmux_all_sessions() -> list[TmuxSession]:
    """Fetch all tmux sessions and their windows in two calls."""
    # Get sessions
    sess_result = subprocess.run(
        ["tmux", "list-sessions", "-F", "#{session_name}\t#{session_path}\t#{session_activity}"],
        capture_output=True,
        text=True,
        timeout=5,
    )
    if sess_result.returncode != 0:
        return []

    sessions: dict[str, TmuxSession] = {}
    for line in sess_result.stdout.strip().splitlines():
        parts = line.split("\t", 2)
        if len(parts) == 3:
            activity = int(parts[2]) if parts[2].isdigit() else 0
            sessions[parts[0]] = TmuxSession(
                name=parts[0], path=parts[1], last_activity=activity, windows=[],
            )

    if not sessions:
        return []

    # Get all windows across all sessions in a single call
    win_result = subprocess.run(
        [
            "tmux",
            "list-windows",
            "-a",
            "-F",
            "#{session_name}\t#{window_index}\t#{window_name}\t#{pane_current_command}\t#{pane_current_path}",
        ],
        capture_output=True,
        text=True,
        timeout=5,
    )
    if win_result.returncode == 0:
        for line in win_result.stdout.strip().splitlines():
            parts = line.split("\t", 4)
            if len(parts) == 5 and parts[0] in sessions:
                sessions[parts[0]].windows.append(
                    {
                        "index": parts[1],
                        "name": parts[2],
                        "command": parts[3],
                        "path": parts[4],
                    }
                )

    return list(sessions.values())


def session_has_opencode(windows: list[dict[str, str]]) -> bool:
    """Check if any pane in the session is running opencode."""
    return any(w["command"] == "opencode" for w in windows)


def session_cwd(session_path: str, windows: list[dict[str, str]]) -> str:
    """Get the working directory for the session (first window's pane path)."""
    if windows:
        return windows[0]["path"]
    return session_path


# ── Git helpers ──────────────────────────────────────────────────────

@dataclass
class GitInfo:
    root: str
    branch: Optional[str]


def git_info(directory: str) -> Optional[GitInfo]:
    """Get git root and branch in a single subprocess call."""
    result = subprocess.run(
        ["git", "-C", directory, "rev-parse", "--show-toplevel", "--abbrev-ref", "HEAD"],
        capture_output=True,
        text=True,
        timeout=5,
    )
    if result.returncode != 0:
        return None
    lines = result.stdout.strip().splitlines()
    root = lines[0] if lines else directory
    branch = lines[1] if len(lines) > 1 and lines[1] != "HEAD" else None
    return GitInfo(root=root, branch=branch)


# ── OpenCode state detection ─────────────────────────────────────────

def _canonical_path(path: str) -> str:
    """Normalise a path so runtime state files match tmux/git paths reliably."""
    return os.path.realpath(os.path.expanduser(path))


def _load_opencode_runtime_states() -> list[OpenCodeRuntimeState]:
    """Load session state files written by the OpenCode session-state plugin."""
    if not OPENCODE_STATE_DIR.exists():
        return []

    states: list[OpenCodeRuntimeState] = []
    for path in OPENCODE_STATE_DIR.glob("*.json"):
        try:
            data = json.loads(path.read_text())
            session_id = data.get("session_id")
            directory = data.get("directory")
            worktree = data.get("worktree")
            state = data.get("state")
            updated_at = data.get("updated_at")

            if not isinstance(session_id, str):
                continue
            if not isinstance(directory, str) or not isinstance(worktree, str):
                continue
            if state not in OC_PRIORITY:
                continue
            if not isinstance(updated_at, int):
                continue

            title = data.get("title", "")
            time_updated = data.get("time_updated", updated_at)
            server_url = data.get("server_url", "")

            states.append(
                OpenCodeRuntimeState(
                    session_id=session_id,
                    directory=_canonical_path(directory),
                    worktree=_canonical_path(worktree),
                    state=state,
                    updated_at=updated_at,
                    title=title if isinstance(title, str) else "",
                    time_updated=time_updated if isinstance(time_updated, int) else updated_at,
                    server_url=server_url if isinstance(server_url, str) else "",
                )
            )
        except (OSError, UnicodeDecodeError, json.JSONDecodeError, TypeError, ValueError):
            continue

    return states


def _today_cutoff_ms() -> int:
    """Midnight local time today, as milliseconds since epoch."""
    return int(datetime.today().replace(hour=0, minute=0, second=0, microsecond=0).timestamp() * 1000)


def opencode_sessions_by_worktree() -> dict[str, list[OpenCodeRuntimeState]]:
    """Load all OpenCode runtime states and group by canonical worktree path.

    Only includes sessions that are non-idle or were last active today.
    Sessions within each group are sorted: non-idle first (by severity),
    then by time_updated descending.
    """
    all_states = _load_opencode_runtime_states()
    if not all_states:
        return {}

    cutoff = _today_cutoff_ms()

    # Deduplicate by session_id (keep the one with the best state)
    by_id: dict[str, OpenCodeRuntimeState] = {}
    for s in all_states:
        existing = by_id.get(s.session_id)
        if existing is None or _prefer_runtime_state(s, existing):
            by_id[s.session_id] = s

    # Filter: non-idle, or idle but updated today
    filtered = [
        s for s in by_id.values()
        if s.state != "idle" or s.time_updated >= cutoff
    ]

    # Group by worktree
    grouped: dict[str, list[OpenCodeRuntimeState]] = {}
    for s in filtered:
        grouped.setdefault(s.worktree, []).append(s)

    # Sort within each group
    for sessions in grouped.values():
        sessions.sort(key=lambda s: (
            -OC_PRIORITY.get(s.state, -1),
            -s.time_updated,
        ))

    return grouped


def _load_session_state(session_id: str) -> Optional[dict]:
    """Load runtime state file for a session."""
    state_path = OPENCODE_STATE_DIR / f"{session_id}.json"
    try:
        return json.loads(state_path.read_text())
    except (OSError, json.JSONDecodeError):
        return None


# ── OpenCode API helpers ─────────────────────────────────────────────

def _api_get(server_url: str, path: str, timeout: float = 2.0) -> Optional[dict | list]:
    """Make a GET request to the opencode API."""
    from urllib.request import Request, urlopen
    from urllib.error import URLError

    url = f"{server_url.rstrip('/')}{path}"
    try:
        req = Request(url, headers={"Accept": "application/json"})
        with urlopen(req, timeout=timeout) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode())
    except (URLError, OSError, json.JSONDecodeError, ValueError):
        pass
    return None


def _fetch_session_info(server_url: str, session_id: str) -> Optional[dict]:
    """Fetch session details from the opencode API."""
    return _api_get(server_url, f"/session/{session_id}")


def _fetch_session_messages(server_url: str, session_id: str, limit: int = 10) -> list[dict]:
    """Fetch recent messages for a session."""
    result = _api_get(server_url, f"/session/{session_id}/message?limit={limit}")
    return result if isinstance(result, list) else []


def _fetch_session_status(server_url: str, session_id: str) -> str:
    """Fetch current session status (idle/busy/retry)."""
    result = _api_get(server_url, "/session/status")
    if isinstance(result, dict) and session_id in result:
        status = result[session_id]
        if isinstance(status, dict):
            return status.get("type", "idle")
    return "idle"


# ── Preview rendering ────────────────────────────────────────────────

def _visible_len(s: str) -> int:
    """Return visible length of string, ignoring ANSI escape codes."""
    import re
    return len(re.sub(r'\x1b\[[0-9;]*m', '', s))


def _wrap_text(text: str, width: int, indent: int = 0) -> list[str]:
    """Word-wrap text to fit within width, preserving line breaks."""
    import textwrap

    if not text:
        return []

    wrapper = textwrap.TextWrapper(
        width=max(width - indent, 20),
        initial_indent=" " * indent,
        subsequent_indent=" " * indent,
        break_long_words=True,
        break_on_hyphens=False,
    )

    # Split by newlines, wrap each paragraph, preserve empty lines
    lines: list[str] = []
    for paragraph in text.split("\n"):
        paragraph = paragraph.strip()
        if not paragraph:
            lines.append(" " * indent)  # Preserve empty line with indent
        else:
            lines.extend(wrapper.wrap(paragraph))

    return lines


def _extract_tool_input(tool: str, state: dict) -> str:
    """Extract the key input parameter for a tool call."""
    inp = state.get("input", {})
    if not isinstance(inp, dict):
        return ""

    # Shorten paths by removing home prefix
    def shorten_path(p: str) -> str:
        home = os.path.expanduser("~")
        if p.startswith(home):
            return "~" + p[len(home):]
        # Also try /home/user pattern
        if p.startswith("/home/"):
            parts = p.split("/", 3)
            if len(parts) >= 4:
                return "~/" + parts[3]
        return p

    def truncate(s: str, max_len: int = 50) -> str:
        s = s.replace("\n", " ").strip()
        if len(s) > max_len:
            return s[:max_len - 3] + "..."
        return s

    # Tool-specific input extraction
    tool_lower = tool.lower()

    if tool_lower in ("read", "edit", "write"):
        path = inp.get("filePath", inp.get("path", ""))
        return shorten_path(path) if path else ""

    if tool_lower in ("glob", "grep"):
        pattern = inp.get("pattern", "")
        path = inp.get("path", "")
        if pattern and path:
            return f"{pattern} in {shorten_path(path)}"
        return pattern or shorten_path(path)

    if tool_lower == "bash":
        cmd = inp.get("command", "")
        return truncate(cmd, 50)

    if tool_lower == "task":
        desc = inp.get("description", "")
        if desc:
            return truncate(desc, 50)
        prompt = inp.get("prompt", "")
        return truncate(prompt, 50)

    if tool_lower == "todowrite":
        todos = inp.get("todos", [])
        if isinstance(todos, list):
            return f"{len(todos)} items"
        return ""

    if tool_lower == "question":
        questions = inp.get("questions", [])
        if isinstance(questions, list) and questions:
            first = questions[0]
            if isinstance(first, dict):
                return truncate(first.get("question", first.get("header", "")), 50)
        return ""

    # Fallback: try common field names
    for key in ("filePath", "path", "command", "query", "url", "description", "name"):
        if key in inp:
            val = inp[key]
            if isinstance(val, str) and val:
                return truncate(shorten_path(val) if "path" in key.lower() else val, 50)

    return ""


def _render_tool_part(part: dict, c: _Colours) -> Optional[str]:
    """Render a tool call as a single line: icon + tool name + input.

    Examples:
      '▶ Read ~/workspace/dotfiles/stow/...'     (completed)
      '● Task Find opencode API docs'            (running)
      '○ Bash'                                   (pending)
      '✗ Bash curl -s http://...'                (error)
    """
    if part.get("type") != "tool":
        return None

    tool = part.get("tool", "unknown")
    state = part.get("state", {})
    status = state.get("status", "pending")

    # Icon and color based on status
    if status == "completed":
        icon = "▶"
        colour = c.muted
    elif status == "running":
        icon = "●"
        colour = c.foam
    elif status == "error":
        icon = "✗"
        colour = c.love
    else:  # pending
        icon = "○"
        colour = c.muted

    # Format tool name (capitalize first letter)
    tool_name = tool[0].upper() + tool[1:] if tool else "Tool"

    # Extract input
    tool_input = _extract_tool_input(tool, state)

    # Build the line (no leading indent or trailing reset - handled by _render_message)
    if tool_input:
        return f"{colour}{icon} {tool_name} {tool_input}"
    else:
        return f"{colour}{icon} {tool_name}"


def _render_message(msg: dict, c: _Colours, width: int) -> list[str]:
    """Render a message matching opencode TUI styling.

    User messages: iris border ┃, overlay background, 1 cell padding
                   Box width adapts to content (like opencode)
    Assistant messages: no border, indented to align
    """
    lines: list[str] = []
    info = msg.get("info", {})
    parts = msg.get("parts", [])
    role = info.get("role", "unknown")
    is_user = role == "user"

    # Collect content lines first (without trailing resets for user messages)
    content_lines: list[str] = []
    for part in parts:
        part_type = part.get("type", "")

        if part_type == "text":
            text = part.get("text", "")
            if text:
                # Width minus border/padding: "┃ " + content + " " = 3 chars overhead
                wrapped = _wrap_text(text, width - 4, indent=0)
                for line in wrapped[:15]:  # Limit text lines per part
                    content_lines.append(line)
                if len(wrapped) > 15:
                    content_lines.append(f"{c.muted}... ({len(wrapped) - 15} more lines)")

        elif part_type == "tool":
            tool_line = _render_tool_part(part, c)
            if tool_line:
                content_lines.append(tool_line)

        # Skip step-start, step-finish, and other meta parts

    if not content_lines:
        return []

    # Format lines with appropriate styling
    if is_user:
        # Box fills available width (width - 1 for the border character ┃)
        box_interior_width = width - 1

        # Top padding line: ┃ + spaces filling the box
        lines.append(f"{c.iris}┃{c.bg_overlay}{' ' * box_interior_width}{c.reset}")

        # Content lines: ┃ + space + content + padding to fill remaining width
        for content in content_lines:
            visible = _visible_len(content)
            # -2 for the padding spaces on left and right
            right_pad = max(0, box_interior_width - visible - 2)
            lines.append(f"{c.iris}┃{c.bg_overlay} {c.text}{content}{' ' * right_pad} {c.reset}")

        # Bottom padding line
        lines.append(f"{c.iris}┃{c.bg_overlay}{' ' * box_interior_width}{c.reset}")
    else:
        # Assistant: no border, just indented with reset after each line
        for content in content_lines:
            lines.append(f"  {c.text}{content}{c.reset}")

    return lines


def _render_header(
    title: str,
    directory: str,
    status: str,
    runtime_state: str,
    c: _Colours,
    width: int,
) -> list[str]:
    """Render the session header box."""
    # Use runtime state for display (more granular than API status)
    display_state = runtime_state if runtime_state else status

    # State color
    state_colours = {
        "idle": c.muted,
        "running": c.foam,
        "busy": c.foam,
        "question": c.gold,
        "error": c.love,
        "done": c.rose,
        "retry": c.gold,
    }
    state_colour = state_colours.get(display_state, c.muted)

    # Shorten directory (replace home with ~)
    home = os.path.expanduser("~")
    if directory.startswith(home):
        directory = "~" + directory[len(home):]

    # Build header lines
    inner_width = width - 4  # Account for box borders

    # Truncate title if needed
    if len(title) > inner_width - 2:
        title = title[:inner_width - 5] + "..."

    # Top border with title
    top_border = f"╭─ {title} " + "─" * max(0, inner_width - len(title) - 3) + "╮"

    # Info line: directory • status
    info_content = f"{directory} • {display_state}"
    padding = inner_width - len(info_content)
    info_line = f"│ {info_content}" + " " * max(0, padding) + " │"

    # Bottom border
    bottom_border = "╰" + "─" * inner_width + "╯"

    return [
        f"{c.muted}{top_border}{c.reset}",
        f"{c.muted}│ {c.subtle}{directory}{c.muted} • {state_colour}{display_state}{c.muted}" + " " * max(0, padding) + f" │{c.reset}",
        f"{c.muted}{bottom_border}{c.reset}",
    ]


def _render_session_preview(
    session_info: dict,
    messages: list[dict],
    api_status: str,
    runtime_state: str,
    c: _Colours,
    width: int,
    height: int,
) -> str:
    """Render complete preview for fzf, fitting within height lines."""
    lines: list[str] = []

    # Header (3 lines)
    title = session_info.get("title", "Untitled session")
    directory = session_info.get("directory", "")
    header_lines = _render_header(title, directory, api_status, runtime_state, c, width)
    lines.extend(header_lines)
    lines.append("")  # Blank line after header

    # Available space for messages
    available = height - len(lines) - 1  # Reserve 1 line for potential truncation notice

    # Render messages (already in chronological order, oldest first)
    message_lines: list[str] = []
    for msg in messages:
        msg_rendered = _render_message(msg, c, width)
        message_lines.extend(msg_rendered)
        message_lines.append("")  # Blank line between messages

    # If messages overflow, keep the newest (at the end)
    if len(message_lines) > available:
        # Calculate how many messages we need to skip
        skipped_lines = len(message_lines) - available + 1
        truncation_notice = f"{c.muted}... earlier messages truncated ...{c.reset}"
        message_lines = [truncation_notice, ""] + message_lines[-(available - 2):]

    lines.extend(message_lines)

    return "\n".join(lines)


def _dismiss_done_session(state: OpenCodeRuntimeState) -> None:
    """Dismiss a done session by rewriting its state file to idle and
    leaving a .dismiss marker for the plugin to clear its in-memory set.
    """
    try:
        OPENCODE_STATE_DIR.mkdir(parents=True, exist_ok=True)

        # Rewrite the state file directly for immediate effect
        idle_data = json.dumps({
            "version": 2,
            "session_id": state.session_id,
            "directory": state.directory,
            "worktree": state.worktree,
            "state": "idle",
            "title": state.title,
            "time_updated": state.time_updated,
            "updated_at": state.updated_at,
            "server_url": state.server_url,
        })
        state_path = OPENCODE_STATE_DIR / f"{state.session_id}.json"
        state_path.write_text(idle_data + "\n")

        # Also leave a .dismiss marker so the plugin clears doneSessions
        (OPENCODE_STATE_DIR / f"{state.session_id}.dismiss").touch()
    except OSError:
        pass


def _dismiss_done_for_tmux_session(session_name: str) -> None:
    """Dismiss all done OpenCode sessions matching a tmux session's directory."""
    sessions = tmux_all_sessions()
    target = next((s for s in sessions if s.name == session_name), None)
    if not target:
        return

    cwd = session_cwd(target.path, target.windows)
    gi = git_info(cwd)
    lookup_dir = _canonical_path(gi.root if gi else cwd)

    for state in _load_opencode_runtime_states():
        if state.state != "done":
            continue
        if _canonical_path(state.directory) == lookup_dir or _canonical_path(state.worktree) == lookup_dir:
            _dismiss_done_session(state)


def _select_opencode_session(session_id: str) -> bool:
    """Tell the opencode TUI to switch to the given session via its HTTP API.

    Looks up the server_url from the session's runtime state file and
    POSTs a tui.session.select event.  Returns True if successful.
    """
    from urllib.request import Request, urlopen
    from urllib.error import URLError

    state_path = OPENCODE_STATE_DIR / f"{session_id}.json"
    try:
        data = json.loads(state_path.read_text())
        server_url = data.get("server_url", "")
    except (OSError, json.JSONDecodeError):
        return False

    if not server_url:
        return False

    url = f"{server_url.rstrip('/')}/tui/publish"
    payload = json.dumps({
        "type": "tui.session.select",
        "properties": {"sessionID": session_id},
    }).encode()

    try:
        req = Request(url, data=payload, headers={"Content-Type": "application/json"})
        with urlopen(req, timeout=2) as resp:
            return resp.status == 200
    except (URLError, OSError, ValueError):
        return False


# ── GitHub PR lookup ─────────────────────────────────────────────────

def fetch_pr(directory: str, branch: str) -> Optional[PRInfo]:
    """Check for an open PR on the given branch using gh, cached with bkt."""
    try:
        result = subprocess.run(
            [
                "bkt",
                "--ttl",
                BKT_TTL,
                "--cwd",
                "--discard-failures",
                "--",
                "gh",
                "pr",
                "view",
                "--json",
                "number,title,url,isDraft,state",
            ],
            capture_output=True,
            text=True,
            timeout=15,
            cwd=directory,
        )
        if result.returncode != 0:
            return None

        data = json.loads(result.stdout)
        if data.get("state") != "OPEN":
            return None

        return PRInfo(
            number=data["number"],
            title=data["title"],
            url=data["url"],
            is_draft=data.get("isDraft", False),
        )
    except (subprocess.TimeoutExpired, json.JSONDecodeError, KeyError, OSError):
        return None


# ── Session enrichment ───────────────────────────────────────────────

def _worst_state(sessions: list[OpenCodeRuntimeState]) -> Optional[str]:
    """Return the highest-severity state from a list of sessions."""
    if not sessions:
        return None
    return max(
        (s.state for s in sessions),
        key=lambda st: OC_PRIORITY.get(st, -1),
    )


def enrich_sessions(
    tmux_sessions: list[TmuxSession],
    include_pr: bool = False,
) -> list[SessionInfo]:
    """Enrich tmux sessions with git, opencode, and PR info."""
    # Step 1: Determine directories, branches, and opencode presence
    enriched: list[dict] = []

    for ts in tmux_sessions:
        cwd = session_cwd(ts.path, ts.windows)
        has_oc = session_has_opencode(ts.windows)
        gi = git_info(cwd)

        info = {
            "name": ts.name,
            "directory": cwd,
            "git_root": gi.root if gi else None,
            "branch": gi.branch if gi else None,
            "has_opencode": has_oc,
            "last_activity": ts.last_activity,
        }
        enriched.append(info)

    # Step 2: Load OpenCode sessions grouped by worktree
    oc_by_worktree = opencode_sessions_by_worktree()

    # Step 3: Fetch PRs in parallel (only for list mode)
    pr_results: dict[str, Optional[PRInfo]] = {}
    if include_pr:
        pr_tasks: list[tuple[str, str, str]] = []
        for info in enriched:
            if info["branch"] and info["git_root"]:
                pr_tasks.append((info["name"], info["git_root"], info["branch"]))

        if pr_tasks:
            with ThreadPoolExecutor(max_workers=8) as pool:
                futures = {
                    pool.submit(fetch_pr, git_root, branch): name
                    for name, git_root, branch in pr_tasks
                }
                for future in as_completed(futures):
                    name = futures[future]
                    try:
                        pr_results[name] = future.result()
                    except Exception:
                        pr_results[name] = None

    # Step 4: Build final SessionInfo objects
    result: list[SessionInfo] = []
    for info in enriched:
        oc_key = _canonical_path(info["git_root"] or info["directory"])
        oc_sessions = oc_by_worktree.get(oc_key, [])

        result.append(
            SessionInfo(
                name=info["name"],
                directory=info["directory"],
                branch=info["branch"],
                has_opencode=info["has_opencode"],
                opencode_state=_worst_state(oc_sessions) if info["has_opencode"] else None,
                last_activity=info["last_activity"],
                pr=pr_results.get(info["name"]),
                opencode_sessions=oc_sessions if info["has_opencode"] else [],
            )
        )

    return result


# ── Formatting helpers ────────────────────────────────────────────────

def _format_time(epoch_ms: int) -> str:
    """Format a millisecond timestamp for display.

    Today:      '14:40'
    This week:  'Mon 14:29'
    Older:      '16 Apr'
    """
    if epoch_ms <= 0:
        return ""
    dt = datetime.fromtimestamp(epoch_ms / 1000)
    now = datetime.now()
    if dt.date() == now.date():
        return dt.strftime("%H:%M")
    delta = (now.date() - dt.date()).days
    if delta < 7:
        return dt.strftime("%a %H:%M")
    return dt.strftime("%-d %b")


def _format_oc_state(
    state: Optional[str],
    has_opencode: bool,
    c: _Colours,
) -> str:
    """Format the opencode state as a coloured icon.

    All states produce exactly 6 terminal columns:
    icon (2 cols) + 4 chars of status/padding.
    """
    if not has_opencode:
        return "      "  # 6 spaces

    if state == "error":
        return f"{c.love}{OC_ICON} err{c.reset}"
    if state == "question":
        return f"{c.gold}{OC_ICON} ?  {c.reset}"
    if state == "done":
        return f"{c.rose}{OC_ICON} ✓  {c.reset}"
    if state == "running":
        return f"{c.foam}{OC_ICON} .. {c.reset}"
    # idle or unknown
    return f"{c.muted}{OC_ICON}    {c.reset}"


def _format_session_oc_state(state: str, c: _Colours) -> str:
    """Format an individual session's state as a coloured icon (4 cols)."""
    if state == "error":
        return f"{c.love}{OC_ICON} !{c.reset}"
    if state == "question":
        return f"{c.gold}{OC_ICON} ?{c.reset}"
    if state == "done":
        return f"{c.rose}{OC_ICON} ✓{c.reset}"
    if state == "running":
        return f"{c.foam}{OC_ICON} ·{c.reset}"
    # idle
    return f"{c.muted}{OC_ICON}  {c.reset}"


# ── Formatting: list mode ────────────────────────────────────────────

def format_list(sessions: list[SessionInfo], c: _Colours) -> str:
    """Format sessions as ANSI-coloured lines for fzf.

    Output is grouped: each tmux session is a header line, with OpenCode
    sessions listed underneath.  Both header and session lines are
    selectable in fzf; both encode the tmux session name in the same
    tab-delimited position so _extract_session_name() works for either.

    Sessions are sorted by opencode severity (error > question > running >
    idle > not running) so the ones needing attention appear first.
    """
    if not sessions:
        return ""

    # Sort groups: highest opencode severity first, then most recent, then alphabetical
    sessions = sorted(
        sessions,
        key=lambda s: (
            -OC_PRIORITY.get(s.opencode_state or "", -1) if s.has_opencode else 10,
            -s.last_activity,
            s.name,
        ),
    )

    # Calculate column widths across all header lines
    max_name = max(len(s.name) for s in sessions)
    max_branch = max(len(s.branch or "—") for s in sessions)

    # Calculate title width for session detail lines
    all_titles: list[str] = []
    for s in sessions:
        for oc in s.opencode_sessions:
            title = oc.title or oc.session_id[:16]
            if len(title) > 50:
                title = title[:47] + "..."
            all_titles.append(title)
    max_title = max((len(t) for t in all_titles), default=0)

    lines: list[str] = []
    for s in sessions:
        # ── Header line (tmux session) ──
        oc_col = _format_oc_state(s.opencode_state, s.has_opencode, c)
        name_col = f"{c.text}{s.name:<{max_name}}{c.reset}"

        branch_str = s.branch or "—"
        if s.branch:
            branch_col = f"{c.iris}{branch_str:<{max_branch}}{c.reset}"
        else:
            branch_col = f"{c.muted}{branch_str:<{max_branch}}{c.reset}"

        pr_col = ""
        if s.pr:
            draft = f"{c.muted}draft " if s.pr.is_draft else ""
            title = s.pr.title
            if len(title) > 40:
                title = title[:37] + "..."
            pr_col = f"  {draft}{c.foam}#{s.pr.number} {c.subtle}{title}{c.reset}"

        header = f" {oc_col}\t{name_col}  {branch_col}{pr_col}"
        lines.append(header)

        # ── Session detail lines (OpenCode sessions under this tmux session) ──
        if not s.opencode_sessions:
            continue

        for i, oc in enumerate(s.opencode_sessions):
            # fzf renders bottom-to-top: last emitted session appears at
            # the visual top of the group, so it gets ┌.  All others get ├.
            tree = "┌" if i == len(s.opencode_sessions) - 1 else "├"

            oc_icon = _format_session_oc_state(oc.state, c)

            title = oc.title or oc.session_id[:16]
            if len(title) > 50:
                title = title[:47] + "..."

            time_str = _format_time(oc.time_updated)

            # Colour the title: non-idle gets text colour, idle gets muted
            if oc.state != "idle":
                title_col = f"{c.text}{title:<{max_title}}{c.reset}"
            else:
                title_col = f"{c.muted}{title:<{max_title}}{c.reset}"

            time_col = f"{c.subtle}{time_str}{c.reset}" if time_str else ""

            # Tab-delimited fields:
            #   {1} tree/icon prefix
            #   {2} tmux session name (for switch command)
            #   {3} session ID (for session select, hidden via dim)
            detail = f" {c.muted}{tree}{c.reset} {oc_icon}\t{c.dim}{s.name:<{max_name}}{c.reset}  {title_col}  {time_col}\t{c.dim}{oc.session_id}{c.reset}"
            lines.append(detail)

    return "\n".join(lines)


# ── Formatting: indicator mode ───────────────────────────────────────

def format_indicator(sessions: list[SessionInfo]) -> str:
    """Format a compact tmux status bar segment.

    Shows the highest-severity opencode state across all sessions.
    Uses tmux #[] colour codes (not ANSI escapes).
    """
    # Collect states for sessions that actually have opencode running
    states: list[str] = []
    for s in sessions:
        if s.has_opencode and s.opencode_state:
            states.append(s.opencode_state)

    if not states:
        return ""

    # Find highest severity
    worst = max(states, key=lambda st: OC_PRIORITY.get(st, -1))

    # Count sessions at that severity
    count = sum(1 for st in states if st == worst)

    # tmux colour codes (Rose Pine)
    tmux_colours = {
        "error": "#eb6f92",    # love
        "question": "#f6c177", # gold
        "done": "#ebbcba",     # rose
        "running": "#9ccfd8",  # foam
        "idle": "#6e6a86",     # muted
    }

    colour = tmux_colours.get(worst, "#6e6a86")
    count_str = f" {count}" if count > 1 else ""

    return f"#[fg={colour}]{OC_ICON}{count_str}#[fg=default]"


# ── Commands ─────────────────────────────────────────────────────────

def cmd_list(args: argparse.Namespace) -> None:
    """List enriched tmux sessions for fzf."""
    raw_sessions = tmux_all_sessions()
    if not raw_sessions:
        return

    sessions = enrich_sessions(raw_sessions, include_pr=not args.no_pr)
    c = _Colours(enabled=sys.stdout.isatty() or args.ansi)
    output = format_list(sessions, c)
    if output:
        print(output)


def cmd_indicator(args: argparse.Namespace) -> None:
    """Print a compact tmux status bar indicator."""
    raw_sessions = tmux_all_sessions()
    if not raw_sessions:
        return

    sessions = enrich_sessions(raw_sessions, include_pr=False)
    output = format_indicator(sessions)
    if output:
        print(output, end="")


def _extract_session_name(raw: str) -> str:
    """Extract the tmux session name from a raw fzf selection line.

    Lines use a tab delimiter between the opencode status column and the
    session info.  Takes the first word from the second tab-delimited field,
    falling back to the first word overall.
    """
    import re

    clean = re.sub(r"\x1b\[[0-9;]*m", "", raw)
    parts = clean.split("\t")
    field = parts[1] if len(parts) >= 2 else parts[0]
    field = field.strip()
    return field.split()[0] if field else ""


def _extract_opencode_session_id(raw: str) -> Optional[str]:
    """Extract the OpenCode session ID from a session detail line.

    Session detail lines have a third tab-delimited field containing the
    session ID (e.g. ses_xxx).  Header lines have no third field.
    Returns None if the line is a header line or has no session ID.
    """
    import re

    clean = re.sub(r"\x1b\[[0-9;]*m", "", raw)
    parts = clean.split("\t")
    if len(parts) >= 3:
        sid = parts[2].strip()
        if sid.startswith("ses_"):
            return sid
    return None


def _find_opencode_window(session_name: str) -> Optional[str]:
    """Return the window index running opencode in the given session."""
    result = subprocess.run(
        [
            "tmux",
            "list-windows",
            "-t",
            session_name,
            "-F",
            "#{window_index}\t#{pane_current_command}",
        ],
        capture_output=True,
        text=True,
        timeout=5,
    )
    if result.returncode != 0:
        return None
    for line in result.stdout.strip().splitlines():
        parts = line.split("\t", 1)
        if len(parts) == 2 and parts[1] == "opencode":
            return parts[0]
    return None


def cmd_switch(args: argparse.Namespace) -> None:
    """Switch to the opencode window in the given tmux session.

    If the selected line is a session detail line (has a session ID in
    the third tab field), also tell the opencode TUI to navigate to
    that specific session via its HTTP API.
    """
    session_name = _extract_session_name(args.session)
    if not session_name:
        return

    # If a specific opencode session was selected, switch to it in the TUI
    oc_session_id = _extract_opencode_session_id(args.session)
    if oc_session_id:
        _select_opencode_session(oc_session_id)

    window = _find_opencode_window(session_name)
    if window:
        subprocess.run(
            ["tmux", "switch-client", "-t", f"{session_name}:{window}"],
            timeout=5,
        )
    else:
        subprocess.run(["tmux", "switch-client", "-t", session_name], timeout=5)

    _dismiss_done_for_tmux_session(session_name)


def cmd_seen(args: argparse.Namespace) -> None:
    """Dismiss done state for all OpenCode sessions in the given tmux session."""
    _dismiss_done_for_tmux_session(args.session)


def cmd_dismiss(args: argparse.Namespace) -> None:
    """Dismiss done state without switching to the session."""
    session_name = _extract_session_name(args.session)
    if not session_name:
        return
    _dismiss_done_for_tmux_session(session_name)


def cmd_select(args: argparse.Namespace) -> None:
    """Switch the opencode TUI to a specific session (no tmux switch)."""
    oc_session_id = _extract_opencode_session_id(args.session)
    if oc_session_id:
        _select_opencode_session(oc_session_id)


def cmd_preview(args: argparse.Namespace) -> None:
    """Render session content via API for fzf preview.

    Fetches session info and recent messages from the opencode HTTP API
    and renders them with ANSI colors.  Does not switch the TUI view.
    """
    session_name = _extract_session_name(args.session)
    oc_session_id = _extract_opencode_session_id(args.session)

    if not oc_session_id:
        # Header line selected - show tmux pane snapshot
        if not session_name:
            return

        # Try opencode window first, fall back to current window
        window = _find_opencode_window(session_name)
        if window:
            target = f"{session_name}:{window}"
        else:
            target = session_name

        # Get pane height to calculate the start line for bottom capture
        height_result = subprocess.run(
            ["tmux", "display-message", "-t", target, "-p", "#{pane_height}"],
            capture_output=True,
            text=True,
            timeout=5,
        )
        pane_height = int(height_result.stdout.strip()) if height_result.returncode == 0 else 80

        preview_lines = int(os.environ.get("FZF_PREVIEW_LINES", "40"))
        start_line = max(0, pane_height - preview_lines)

        result = subprocess.run(
            ["tmux", "capture-pane", "-e", "-p", "-t", target, "-S", str(start_line)],
            capture_output=True,
            text=True,
            timeout=5,
        )
        if result.returncode == 0:
            print(result.stdout, end="")
        return

    # Load runtime state to get server_url
    state = _load_session_state(oc_session_id)
    if not state:
        print(f"Session state not found")
        return

    server_url = state.get("server_url", "")
    if not server_url:
        print(f"No server URL for session")
        return

    # Fetch from API
    session_info = _fetch_session_info(server_url, oc_session_id)
    if not session_info:
        print("Could not connect to opencode server")
        return

    messages = _fetch_session_messages(server_url, oc_session_id, limit=20)
    api_status = _fetch_session_status(server_url, oc_session_id)

    # API returns messages in chronological order (oldest first),
    # which is what we want (newest at bottom when rendered top-to-bottom)

    # Get dimensions from fzf environment
    width = int(os.environ.get("FZF_PREVIEW_COLUMNS", "80"))
    height = int(os.environ.get("FZF_PREVIEW_LINES", "40"))

    c = _Colours(enabled=True)
    runtime_state = state.get("state", "idle")

    output = _render_session_preview(
        session_info, messages, api_status, runtime_state, c, width, height
    )
    print(output, end="")


# ── Main ─────────────────────────────────────────────────────────────

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Enriched tmux session listing and status indicator.",
    )
    sub = parser.add_subparsers(dest="command")

    list_parser = sub.add_parser("list", help="ANSI-coloured session list for fzf")
    list_parser.add_argument(
        "--ansi",
        action="store_true",
        help="Force ANSI colour output (useful when piping to fzf --ansi)",
    )
    list_parser.add_argument(
        "--no-pr",
        action="store_true",
        help="Skip GitHub PR lookups for fast initial rendering",
    )

    sub.add_parser("indicator", help="Compact tmux status bar segment")

    switch_parser = sub.add_parser("switch", help="Switch to opencode window in a session")
    switch_parser.add_argument("session", help="Raw fzf line or session name")

    preview_parser = sub.add_parser("preview", help="Capture opencode pane for fzf preview")
    preview_parser.add_argument("session", help="Raw fzf line or session name")

    seen_parser = sub.add_parser("seen", help="Dismiss done state for a tmux session")
    seen_parser.add_argument("session", help="Tmux session name")

    dismiss_parser = sub.add_parser("dismiss", help="Dismiss done state from fzf picker")
    dismiss_parser.add_argument("session", help="Raw fzf line or session name")

    select_parser = sub.add_parser("select", help="Switch opencode TUI to a session")
    select_parser.add_argument("session", help="Raw fzf line containing session ID")

    args = parser.parse_args()

    if args.command == "list":
        cmd_list(args)
    elif args.command == "indicator":
        cmd_indicator(args)
    elif args.command == "switch":
        cmd_switch(args)
    elif args.command == "preview":
        cmd_preview(args)
    elif args.command == "seen":
        cmd_seen(args)
    elif args.command == "dismiss":
        cmd_dismiss(args)
    elif args.command == "select":
        cmd_select(args)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
