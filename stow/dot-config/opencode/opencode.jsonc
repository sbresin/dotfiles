{
	"$schema": "https://opencode.ai/config.json",
	"default_agent": "plan",
	"plugin": ["@ex-machina/opencode-anthropic-auth@1.8.1"],
	"provider": {
		"flm": {
			"models": {
				"gpt-oss:20b": {
					"_launch": true,
					"name": "GPT-OSS 20B",
				},
				"qwen3.5:9b": {
					"name": "Qwen 3.5 9B",
				},
				"gemma4-it:e2b": {
					"name": "Gemma 4 IT E2B",
				},
				"qwen3:0.6b": {
					"name": "Qwen 3 0.6B",
				},
			},
			"name": "FastFlowLLM (NPU)",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://localhost:52625/v1",
			},
		},
		"ollama": {
			"models": {
				"gemma4:31b": {
					"_launch": true,
					"name": "Gemma 4 31B",
				},
				"gemma4:e4b": {
					"name": "Gemma 4 E4B",
				},
				"glm-4.7-flash:latest": {
					"name": "GLM 4.7 Flash",
				},
			},
			"name": "Ollama (local)",
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://localhost:11434/v1",
			},
		},
	},
	"lsp": {
		"typescript": {
			"command": ["tsgo", "--lsp", "--stdio"],
			"extensions": [
				".ts",
				".tsx",
				".js",
				".jsx",
				".mjs",
				".cjs",
				".mts",
				".cts",
			],
		},
	},
	"permission": {
		"external_directory": {
			"~/workspace/**": "allow",
			"/tmp/opencode-*/**": "allow",
		},
		"edit": {
			"/tmp/opencode-*/**": "allow",
		},
	},
	"mcp": {
		// "github": {
		// 	"type": "local",
		// 	"command": ["github-mcp-server", "stdio", "--dynamic-toolsets"],
		// 	"enabled": true,
		// 	"environment": {
		// 		"GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_MCP_PAT}",
		// 	},
		// },
		"github": {
			"type": "remote",
			"url": "https://api.githubcopilot.com/mcp/",
			"enabled": false,
			"oauth": false,
			"headers": {
				"Authorization": "Bearer {env:GITHUB_MCP_PAT}",
			},
		},
		"terraform": {
			"type": "local",
			"command": ["terraform-mcp-server"],
			"enabled": false,
		},
		"nixos": {
			"type": "local",
			"command": ["uvx", "mcp-nixos"],
			"enabled": false,
		},
		"chrome-devtools": {
			"type": "local",
			"command": [
				"chrome-devtools-mcp",
				"--browser-url=http://127.0.0.1:9222",
			],
			"enabled": false,
		},
		"playwright": {
			"type": "local",
			"command": [
				"playwright-mcp",
				"--headless",
				"--isolated",
				"--browser=chromium",
			],
			"enabled": true,
		},
		"sentry": {
			"type": "remote",
			"url": "https://mcp.sentry.dev/mcp",
			"oauth": {},
			"enabled": false,
		},
		"atlassian": {
			"type": "remote",
			"url": "https://mcp.atlassian.com/v1/mcp",
			"enabled": false,
		},
		// "google-workspace": {
		// 	"type": "local",
		// 	"command": ["workspace-mcp", "--single-user"],
		// 	"enabled": false,
		// 	"environment": {
		// 		"GOOGLE_OAUTH_CLIENT_ID": "{env:WORKSPACE_MCP_OAUTH_CLIENT_ID}",
		// 		"GOOGLE_OAUTH_CLIENT_SECRET": "{env:WORKSPACE_MCP_OAUTH_CLIENT_SECRET}",
		// 		"USER_GOOGLE_EMAIL": "{env:WORKSPACE_MCP_GOOGLE_EMAIL}",
		// 	},
		// },
		"google-workspace": {
			"type": "remote",
			"url": "https://google-workspace-mcp.run.thermondo.de/mcp",
			"enabled": false,
		},
	},
}
